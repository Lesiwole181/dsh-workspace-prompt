{
  "name": "dsh-workspace-prompt",
  "version": "1.0.0",
  "private": true,
  "description": "Per-workspace prompt pages for DeepSeek Harness: choose workspaces in Settings, edit or browse a Markdown prompt per workspace, and inject the enabled prompt into the agent at the start of every conversation in that workspace.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.api.js",
    "client.app.js",
    "client.i18n.js",
    "client.icons.js",
    "client.manage-workspaces.js",
    "client.markdown.js",
    "client.prompt-editor.js",
    "client.styles.js",
    "client.workspace-list.js",
    "cordis.patch.yml",
    "host/*.js",
    "locale/*.json",
    "icon.svg",
    "docs/*.md",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
